{
  "instance": "knowledge-recall",
  "container": "celld-knowledge-recall",
  "container_class": "活跃容器",
  "dir": "/vol1/docker/celld/实例/knowledge-recall",
  "config": "wrangler.template.jsonc",
  "secrets": "secrets.json",
  "config_generated": "wrangler.jsonc",
  "config_injected_keys": [],
  "modules": {
    "worker": true,
    "cron": {
      "root": true,
      "expressions": [
        "17 4 * * *"
      ]
    },
    "d1": true,
    "d1_note": "D1 由同容器的 knowledge-timeline-impression 独占写；本实例只通过 service binding 读",
    "workflows": false,
    "queues": false,
    "kv": false,
    "r2": false,
    "services": [
      "TIMELINE"
    ],
    "do": false,
    "containers": false,
    "worker_loaders": false,
    "assets": false
  },
  "external_probes": [
    {
      "name": "rag-ferrite",
      "base_url": "http://rag-ferrite:4242",
      "checks": [
        "health",
        "list_shape",
        "query_shape"
      ]
    },
    {
      "name": "celld-typescript-check",
      "base_url": "http://celld-intermediary:8081",
      "standby_container": "celld-typescript-check",
      "checks": [
        "health",
        "check_roundtrip"
      ]
    }
  ],
  "typecheck": {
    "enabled": true,
    "owner": "celld-typescript-check",
    "entrypoint": "http://celld-intermediary:8081/check",
    "pass_criteria": "errors==0 且无 lib 缺失指纹码"
  },
  "typecheck_dirs": [
    "."
  ]
}
