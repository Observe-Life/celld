{ "compilerOptions": { "strict": true, "noEmit": true, "target": "ES2022",
  "module": "ESNext", "moduleResolution": "Bundler",
  "lib": ["ES2022", "WebWorker"], "types": ["@cloudflare/workers-types"],
  "skipLibCheck": true, "noUncheckedIndexedAccess": true,
  "exactOptionalPropertyTypes": true, "noImplicitReturns": true },
  "include": ["src/**/*.ts"] }
