{
  "name": "celld-agent-to-rag",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "triggers": {
    // 占位 cron：每年 1 月 1 日 00:00。目的只是让 Worker 导出 .cron 这个
    // Durable Object class。留空数组或删除本段都会让平台仍尝试激活 .cron cell，
    // 却找不到 DO class，于是无限重试，而每次失败都写一个新 epoch（实测 1.86 个/秒）。
    "crons": ["0,30 * * * *"]
  },
  "workflows": [
    { "binding": "SYNC_FLOW", "name": "session-sync", "class_name": "SessionSyncFlow" }
  ],
  "kv_namespaces": [{ "binding": "STATE", "id": "sync-state" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sync-files" }],
  "disks": [
    { "binding": "MIRROR", "path": "/data/session-mirror", "writable": true, "allow_dotfiles": false }
  ],
  "vars": {
    "RAGF_URL": "http://rag-ferrite:4242",
    "RAGF_KEY": "@RAGF_KEY@",
    "GEMINI_KEY": "@GEMINI_KEY@",
    "SHAPI_KEY": "@SHAPI_KEY@",
    "JBB_KEY": "@JBB_KEY@",
    "SKIP_GEMINI": "0",
    "INGEST_TOKEN": "@INGEST_TOKEN@",
    "SYNC_ALLOWLIST": "@SYNC_ALLOWLIST@",
    "SYNC_CONCURRENCY": "2",
    "ASTRBOT_API_KEY": "@ASTRBOT_API_KEY@",
    "ASTRBOT_URL": "http://astrbot:6185"
  }
}
