{
  "name": "multimedia-transcript-summary",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workflows": [
    {
      "binding": "FLOW",
      "name": "multimedia-transcribe",
      "class_name": "TranscribeFlow"
    },
    {
      "binding": "PIPELINE",
      "name": "multimedia-pipeline",
      "class_name": "PipelineFlow"
    }
  ],
  "vars": {
    "EGRESS_URL": "http://oc-egress:8888",
    "TIKHUB_TOKEN": "@TIKHUB_TOKEN@",
    "RELAY_TOKEN": "@RELAY_TOKEN@",
    "GEMINI_KEY": "@GEMINI_KEY@",
    "SUPABASE_KEY": "@SUPABASE_KEY@",
    "SERVERCHAN_URL": "@SERVERCHAN_URL@",
    "SHAPI_KEY": "@SHAPI_KEY@"
  }
}
