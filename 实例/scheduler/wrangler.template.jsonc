{
  "name": "scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "triggers": {
    // 占位 cron：每年 1 月 1 日 00:00。目的只是让 Worker 导出 .cron 这个
    // Durable Object class。留空数组或删除本段，桶里已有的 .cron cell 注册仍会
    // 被平台尝试激活，于是找不到 DO class，就无限失败重试，而每次失败都泄漏一个
    // epoch（celld issue #276）。要恢复真实对账节律时改这一行即可。
    "crons": ["0 0 1 1 *"]
  },
  "services": [
    { "binding": "MM", "service": "multimedia-pipeline" }
  ],
  "vars": {}
}
