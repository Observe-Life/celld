{
  "instance": "celld 主容器（scheduler + multimedia）",
  "dir": "/vol1/docker/celld/实例",
  "config": "multimedia/wrangler.template.jsonc",
  "secrets": "multimedia/secrets.json",
  "modules": {
    "worker": true,
    "cron": {
      "root": true,
      "expressions": [],
      "owner": "scheduler",
      "note": "会话同步的 cron 已随实例迁至 celld-agent-to-rag"
    },
    "workflows": true,
    "queues": false,
    "kv": false,
    "r2": false,
    "services": [
      "MM",
      "SCHEDULER"
    ],
    "d1": false,
    "do": false,
    "containers": false,
    "worker_loaders": false,
    "assets": false
  },
  "external_probes": [
    {
      "name": "jbb",
      "base_url": "https://cn.jbbt.cc/v1",
      "checks": [
        "models_reachable",
        "small_completion",
        "mime_matrix",
        "--full:body_size",
        "--full:token_limit"
      ]
    },
    {
      "name": "weknora",
      "base_url": "http://weknora-lite:8080",
      "checks": [
        "health",
        "list_shape",
        "state_machine"
      ]
    }
  ],
  "typecheck": {
    "enabled": true,
    "owner": "celld-typescript-check",
    "entrypoint": "http://celld-wake-container:8081/check",
    "delivery": "容器内走容器名:机内端口；宿主机闸门走 docker exec（不开宿主端口）",
    "pass_criteria": "errors==0 且无 lib 缺失指纹码 TS2318/2583/2585；投递失败或回执异常一律 FAIL"
  },
  "config_generated": "multimedia/wrangler.jsonc",
  "config_injected_keys": [
    "TIKHUB_TOKEN",
    "RELAY_TOKEN",
    "GEMINI_KEY",
    "SUPABASE_KEY",
    "SERVERCHAN_URL",
    "SHAPI_KEY"
  ],
  "typecheck_dirs": [],
  "container": "celld",
  "container_class": "活跃容器",
  "note": "本容器含 scheduler 与 multimedia 两个实例，但 acceptance.json 目前是「一实例一声明」结构，这里只以 multimedia 为锚点做 L0；逐实例声明待后续继续拆分时补齐。L1 暂为空：multimedia 有 15 条、scheduler 有 1 条存量类型错误，按 2026-11-03 决策暂不修，因此它们不在闸门覆盖内（不是已通过，是未纳入）。"
}
