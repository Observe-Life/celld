{
  "instance": "kb-sync",
  "dir": "/vol1/docker/celld/实例",
  "config": "kb-sync/wrangler.template.jsonc",
  "secrets": "kb-sync/secrets.json",
  "modules": {
    "worker": true,
    "cron": {
      "root": true,
      "expressions": [
        "37 * * * *"
      ]
    },
    "queues": {
      "producer": "QUEUE",
      "queue": "kb-conv-sync",
      "dlq": "kb-conv-sync-dlq",
      "max_concurrency": 2,
      "send_batch_limit": 100,
      "message_max_kb": 128
    },
    "kv": {
      "binding": "STATE",
      "namespace": "sync-state",
      "ttl_min_seconds": 60
    },
    "r2": {
      "binding": "FILES",
      "bucket": "sync-files",
      "backend": "s3://celld-fleet"
    },
    "services": [
      "MM",
      "SCHEDULER"
    ],
    "d1": false,
    "do": false,
    "workflows": false,
    "containers": false,
    "worker_loaders": false,
    "assets": false
  },
  "external_probes": [
    {
      "name": "jbb",
      "base_url": "https://cn.jbbt.cc/v1",
      "checks": [
        "models_reachable",
        "small_completion",
        "mime_matrix",
        "--full:body_size",
        "--full:token_limit"
      ]
    },
    {
      "name": "weknora",
      "base_url": "http://weknora-lite:8080",
      "checks": [
        "health",
        "list_shape",
        "state_machine"
      ]
    },
    {
      "name": "celld-typescript-check",
      "base_url": "http://celld-wake-container:8081",
      "standby_container": "celld-typescript-check",
      "checks": [
        "health",
        "check_roundtrip"
      ],
      "note": "常驻空壳容器，node 工作进程由 celld-wake-container 按需 exec；只认唤醒器机内地址，禁止宿主端口映射或直连"
    }
  ],
  "typecheck": {
    "enabled": true,
    "owner": "celld-typescript-check",
    "entrypoint": "http://celld-wake-container:8081/check",
    "delivery": "容器内走容器名:机内端口；宿主机闸门走 docker exec（不开宿主端口）",
    "pass_criteria": "errors==0 且无 lib 缺失指纹码 TS2318/2583/2585；投递失败或回执异常一律 FAIL"
  },
  "config_generated": "kb-sync/wrangler.jsonc",
  "config_injected_keys": [
    "SYNC_ALLOWLIST"
  ],
  "typecheck_dirs": [
    "kb-sync"
  ]
}
